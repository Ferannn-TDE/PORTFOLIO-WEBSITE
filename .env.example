# Copy to .env for local use, and set the same variables in Netlify
# (Site configuration → Environment variables). Never commit .env.

# Server-side only: read by the GitHub activity Netlify Function and the local
# preview middleware. Not VITE_-prefixed, so it never reaches the browser.
#
# Token type: a fine-grained personal access token for your own account with
#   Repository access: "Public repositories (read-only)", and no extra permissions.
# If the contributions query fails with that token, use a classic token with
#   no scopes selected instead (it can read public data only).
# Without a token the strip still works and shows 4 weeks of pushes.
GITHUB_TOKEN=

# Analytics (phase 7). Umami loads only when both are set.
VITE_UMAMI_SRC=
VITE_UMAMI_ID=
